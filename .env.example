# Copy to .env.local, or run `vercel env pull .env.local` after `vercel link`.
# Never commit real values. None of these may use a NEXT_PUBLIC_ prefix.

# Store API base URL. Prepopulated by the Deploy button; keep it unchanged.
API_BASE_URL=

# Store API deployment-protection bypass value. Prepopulated by the Deploy
# button; keep it unchanged. Server-only.
BYPASS_SECRET=

# AI Gateway + Vercel Sandbox authentication for local development.
# Written by `vercel env pull .env.local`; expires after 12 hours, rerun to refresh.
# On Vercel deployments OIDC is automatic and this is not needed.
VERCEL_OIDC_TOKEN=

# Optional: AI Gateway API key instead of OIDC for model calls.
# If used, also add it in Vercel for Development, Preview, and Production.
# AI_GATEWAY_API_KEY=

# Optional: AI Gateway model id for both agents (default: openai/gpt-5.2).
# AGENT_MODEL=

# Optional: name of the admin agent's persistent sandbox (default: ship-shop-admin).
# ADMIN_SANDBOX_NAME=

# Optional: public site URL for metadata (default: http://localhost:3000).
# NEXT_PUBLIC_SITE_URL=
